# Auto-detect text files and normalize line endings
* text=auto

# Python
*.py text eol=lf
*.pyi text eol=lf

# Config / data
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary
*.png binary
*.jpg binary
*.ico binary
